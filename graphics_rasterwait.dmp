00001  0000             ; 10 SYS (4096)
00002  0001             
00003  0001             *=$0801
00004  0801             
00005  0801  0E 08 0A              BYTE    $0E, $08, $0A, $00, $9E, $20, $28,  $34, $30, $39, $36, $29, $00, $00, $00
00006  0810             *=$1000
00007  1000             
00008  1000             MAIN
00009  1000  78                    SEI
00010  1001             LOOP
00011  1001  A9 64                 LDA #100 ;LOAD 100 DECIMAL
00012  1003             WAIT100
00013  1003  CD 12 D0              CMP $D012 ;COMPARA WITH THE CURRENT RASTER SCANLINE NUMBER REGISTER
00014  1006  D0 FB                 BNE WAIT100
00015  1008  A9 02                 LDA #2 ;COLOR RED
00016  100A  8D 20 D0              STA $D020 ;BORDER COLOR
00017  100D             
00018  100D  A9 C8                 LDA #200
00019  100F             WAIT200
00020  100F  CD 12 D0              CMP $D012 ;COMPARA WITH THE CURRENT RASTER SCANLINE NUMBER REGISTER
00021  1012  D0 FB                 BNE WAIT200
00022  1014  A9 0E                 LDA #14 ;COLOR LIGHT BLUE AGAIN
00023  1016  8D 20 D0              STA $D020 ;BORDER COLOR
00024  1019                        
00025  1019  4C 01 10              JMP LOOP
00026  101C                        
00027  101C             

******* 4 Label(s) *******
loop = $1001 
MAIN = $1000 
wait100 = $1003 
wait200 = $100F 

